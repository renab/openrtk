{
  "name": "openrtk",
  "version": "0.1.0",
  "description": "OpenCode plugin for RTK (Rust Token Killer) - reduces LLM token consumption by 60-90% on dev commands",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "files": [
    "lib",
    "opencode.md"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "bun build src/index.ts --outfile dist/openrtk.js --target bun",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.5"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "rtk",
    "token-optimization",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/renab/openrtk"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
